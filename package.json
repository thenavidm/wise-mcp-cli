{
  "name": "@thenavidm/wise-mcp-cli",
  "version": "1.0.0",
  "description": "Wise MCP server and CLI for Claude Code and AI agents. Balances, recipients, quotes and transfers on a Wise business account, with every payment set up unpaid for a person to pay in Wise.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "wise-mcp": "dist/index.js",
    "wise-cli": "dist/index.js",
    "wise-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.24",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/wise-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/wise-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wise",
    "transferwise",
    "wise-api",
    "payments",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools",
    "cli",
    "codex",
    "slipway",
    "invoices",
    "fintech",
    "money-transfer"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
}
